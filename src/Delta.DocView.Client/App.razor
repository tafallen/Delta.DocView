@inject LibraryApiClient LibraryClient
@inject IFavouritesStore Favourites
@inject IPlatform Platform
@inject Delta.DocView.Client.Services.TweaksStore Tweaks
@inject Delta.DocView.Client.Services.UserClient UserClient

@* Note: the Loading branch below is unreachable in Blazor WASM — OnInitializedAsync
   completes before the component renders, so State is always Loaded or Error by the
   time App.razor paints. The pre-render spinner in index.html is the visible indicator. *@
@if (LibraryClient.State == LoadingState.Loading)
{
    <LoadingScreen />
}
else if (LibraryClient.State == LoadingState.Error)
{
    <StartupErrorPage ErrorMessage="@(LibraryClient.ErrorMessage ?? "Unknown error.")" />
}
else
{
    <MainLayout Warning="@LibraryClient.WarningMessage" />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LibraryClient.LoadAsync(), Favourites.InitializeAsync(), Platform.InitializeAsync(), Tweaks.InitializeAsync(), UserClient.LoadAsync());
    }
}
