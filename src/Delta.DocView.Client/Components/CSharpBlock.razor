@using Delta.DocView.Client.Services

<div class="cs-block" data-testid="cs-block">
    <div class="cs-block-header">
        <button class="cs-toggle"
                data-testid="cs-toggle"
                aria-expanded="@(_expanded ? "true" : "false")"
                aria-controls="@($"cs-source-{_sourceId}")"
                @onclick="OnToggleClick">
            @(_expanded ? "▾ Hide C# step definition" : "▸ Show C# step definition")
        </button>
        @if (_expanded)
        {
            <CopyButton Text="@Source" Label="Copy source" ConfirmLabel="✓ source copied" />
        }
    </div>
    @if (_expanded)
    {
        <pre class="cs-source" data-testid="cs-source" id="@($"cs-source-{_sourceId}")" role="region">@foreach (var t in CSharpHighlighter.Tokenise(Source))
{<span class="@t.CssClass">@t.Text</span>}</pre>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Source { get; set; } = "";

    private bool _expanded;
    private string _sourceId = "";

    protected override void OnInitialized()
    {
        _sourceId = Guid.NewGuid().ToString("N")[..8];
    }

    private void OnToggleClick() => _expanded = !_expanded;
}
