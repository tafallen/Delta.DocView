@using Delta.DocView.Client.Services
@inject TweaksStore Tweaks

<div class="cs-block" data-testid="cs-block">
    <div class="cs-block-header">
        <button class="cs-toggle"
                data-testid="cs-toggle"
                aria-expanded="@(_expanded ? "true" : "false")"
                aria-controls="@($"cs-source-{_sourceId}")"
                @onclick="OnToggleClick">
            <span class="cs-toggle-arrow">@(_expanded ? "▾" : "▸")</span>
            <span class="cs-toggle-label">C# step definition</span>
            @if (!string.IsNullOrWhiteSpace(FileRef))
            {
                <span class="cs-toggle-file">@FileRef</span>
            }
        </button>
        @if (_expanded)
        {
            <CopyButton Text="@Source" Label="Copy" ConfirmLabel="✓ copied" />
        }
    </div>
    @if (_expanded)
    {
        <pre class="cs-source" data-testid="cs-source" id="@($"cs-source-{_sourceId}")" role="region">@foreach (var t in CSharpHighlighter.Tokenise(Source))
{<span class="@t.CssClass">@t.Text</span>}</pre>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Source { get; set; } = "";
    [Parameter] public string? FileRef { get; set; }

    private bool _expanded;
    private string _sourceId = "";

    // Read once at creation. Re-selecting a step recreates this block, so it
    // picks up the current default; already-mounted blocks intentionally do NOT
    // react to later SourceDefault changes (US-11 design decision).
    protected override void OnInitialized()
    {
        _sourceId = Guid.NewGuid().ToString("N")[..8];
        _expanded = Tweaks.SourceDefault == SourceDefaultOption.Expanded;
    }

    private void OnToggleClick() => _expanded = !_expanded;
}
