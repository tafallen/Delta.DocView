@using Delta.DocView.Client.Services

<li class="composer-row @(IsDragging ? "is-drag" : "")"
    @ondragover:preventDefault
    @ondrop="OnDrop">
    <span class="drag-handle"
          draggable="true"
          @ondragstart="OnDragStart"
          @ondragend="OnDragEnd"
          aria-hidden="true">⠿</span>
    <span class="composer-keyword">@Keyword</span>
    <span class="composer-row-pattern">@Item.Step.Pattern</span>
    @if (Item.ParamValues.Count > 0)
    {
        <div class="composer-row-values" data-testid="composer-row-values">
            @for (var pi = 0; pi < Item.ParamValues.Count; pi++)
            {
                var capturedPi = pi;
                var label = (pi < Item.Step.Params.Count)
                    ? (Item.Step.Params[pi].Name ?? Item.Step.Params[pi].Type)
                    : $"param {pi + 1}";
                <label class="composer-value-label">
                    <span class="composer-value-name" aria-hidden="true">@label</span>
                    <input class="composer-value-input"
                           type="text"
                           aria-label="@label value"
                           data-testid="param-value-input"
                           value="@Item.ParamValues[capturedPi]"
                           @oninput="e => OnParamValueChanged.InvokeAsync((capturedPi, e.Value?.ToString() ?? string.Empty))" />
                </label>
            }
        </div>
    }
    <div class="composer-row-actions">
        <button class="composer-row-btn"
                type="button"
                title="Move step up"
                aria-label="Move step up"
                data-testid="move-up"
                disabled="@(!CanMoveUp)"
                @onclick="OnMoveUp">▲</button>
        <button class="composer-row-btn"
                type="button"
                title="Move step down"
                aria-label="Move step down"
                data-testid="move-down"
                disabled="@(!CanMoveDown)"
                @onclick="OnMoveDown">▼</button>
        <button class="composer-row-btn"
                type="button"
                title="Go to step"
                aria-label="Navigate to step"
                data-testid="row-navigate"
                @onclick="OnNavigate">→</button>
        <button class="composer-row-btn"
                type="button"
                title="Remove step"
                aria-label="Remove step"
                data-testid="row-remove"
                @onclick="OnRemove">×</button>
    </div>
</li>

@code {
    [Parameter, EditorRequired] public ComposerItem Item { get; set; } = default!;
    [Parameter, EditorRequired] public string Keyword { get; set; } = "";
    [Parameter] public bool IsDragging { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public EventCallback OnNavigate { get; set; }
    [Parameter] public EventCallback OnMoveUp { get; set; }
    [Parameter] public EventCallback OnMoveDown { get; set; }
    [Parameter] public bool CanMoveUp { get; set; }
    [Parameter] public bool CanMoveDown { get; set; }
    [Parameter] public EventCallback OnDragStart { get; set; }
    [Parameter] public EventCallback OnDragEnd { get; set; }
    [Parameter] public EventCallback OnDrop { get; set; }
    [Parameter] public EventCallback<(int Index, string Value)> OnParamValueChanged { get; set; }
}
