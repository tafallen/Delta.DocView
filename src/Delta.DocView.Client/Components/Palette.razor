@using Delta.DocView.Client.Services
@inject PaletteState State
@inject IJSRuntime JS
@implements IDisposable

@if (State.IsOpen)
{
    <div class="palette-backdrop"
         data-testid="palette-backdrop"
         @onclick="State.Close">
        <div class="palette"
             data-testid="palette"
             role="dialog"
             aria-label="Command palette"
             @onclick:stopPropagation="true">
            <input id="@_inputId"
                   class="palette-input"
                   data-testid="palette-input"
                   type="text"
                   placeholder="Search steps…"
                   aria-label="Search steps"
                   role="combobox"
                   aria-expanded="true"
                   aria-controls="@_listboxId"
                   aria-activedescendant="@(_currentResultId ?? "")"
                   value="@State.Query"
                   @oninput="OnInput"
                   @onkeydown="OnKey" />
            <div class="palette-meta" data-testid="palette-meta">
                @if (State.Results.Count == 0 && !string.IsNullOrWhiteSpace(State.Query))
                {
                    <span>No results</span>
                }
                else
                {
                    <span>@State.Results.Count @(State.Results.Count == 1 ? "result" : "results")</span>
                }
            </div>
            <div class="palette-results"
                 data-testid="palette-results"
                 id="@_listboxId"
                 role="listbox"
                 aria-label="Step search results">
                @if (State.Results.Count == 0 && !string.IsNullOrWhiteSpace(State.Query))
                {
                    <div class="palette-empty" data-testid="palette-empty">
                        <p>No step matches "@State.Query".</p>
                        <p class="hint">Try a shorter query, or define a new step in the appropriate <code>*.Steps.cs</code> file.</p>
                    </div>
                }
                else
                {
                    @for (var i = 0; i < State.Results.Count; i++)
                    {
                        var idx = i;
                        var step = State.Results[i];
                        <button class="palette-result @(idx == State.SelectedIndex ? "is-active" : "")"
                                data-testid="palette-result"
                                data-step-id="@step.Id"
                                data-result-index="@i"
                                id="@($"{_resultIdPrefix}-{i}")"
                                role="option"
                                aria-selected="@((idx == State.SelectedIndex) ? "true" : "false")"
                                type="button"
                                @onmouseover="() => State.SetSelectedIndex(idx)"
                                @onclick="() => OnClickResult(step)">
                            <span class="type-chip chip-@step.Type.ToLowerInvariant()">@step.Type</span>
                            <span class="palette-pattern">
                                <PatternRenderer Pattern="@step.Pattern" Query="@State.Query" />
                            </span>
                            <span class="palette-domain">@step.Domain</span>
                            <span class="palette-used">@(step.Used)×</span>
                        </button>
                    }
                }
            </div>
            <div class="palette-footer" data-testid="palette-footer">
                <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
                <span><kbd>↵</kbd> select</span>
                <span><kbd>Esc</kbd> close</span>
            </div>
        </div>
    </div>
}

@code {
    private const int InputDebounceMs = 150;

    private string _inputId = "";
    private string _listboxId = "";
    private string _resultIdPrefix = "";
    private bool _wasOpen;
    private int _lastScrolledIndex = -1;
    private string _pendingQuery = "";
    private System.Threading.Timer? _inputTimer;

    private string? _currentResultId =>
        State.Results.Count > 0 && State.SelectedIndex >= 0 && State.SelectedIndex < State.Results.Count
            ? $"{_resultIdPrefix}-{State.SelectedIndex}"
            : null;

    protected override void OnInitialized()
    {
        var uid = Guid.NewGuid().ToString("N")[..8];
        _inputId         = $"palette-input-{uid}";
        _listboxId       = $"palette-results-{uid}";
        _resultIdPrefix  = $"palette-result-{uid}";
        State.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _pendingQuery = e.Value?.ToString() ?? "";
        _inputTimer ??= new System.Threading.Timer(_ =>
            InvokeAsync(() => State.SetQuery(_pendingQuery)));
        _inputTimer.Change(InputDebounceMs, System.Threading.Timeout.Infinite);
    }

    private void OnKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":   State.MoveSelectionDown(); break;
            case "ArrowUp":     State.MoveSelectionUp();   break;
            case "Enter":       State.SelectCurrent();     break;
            case "Escape":      State.Close();             break;
        }
    }

    private void OnClickResult(Delta.DocView.Shared.Models.Step _) => State.SelectCurrent();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (State.IsOpen && !_wasOpen)
        {
            try { await JS.InvokeVoidAsync("docview.focus.element", _inputId); } catch { }
        }
        else if (!State.IsOpen && _wasOpen)
        {
            try { await JS.InvokeVoidAsync("docview.focus.restorePrevious"); } catch { }
        }

        if (State.IsOpen && State.Results.Count > 0 && _lastScrolledIndex != State.SelectedIndex)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "docview.scrollIntoViewIfNeeded",
                    $"[data-testid='palette'] [data-result-index='{State.SelectedIndex}']");
            }
            catch { }
            _lastScrolledIndex = State.SelectedIndex;
        }
        else if (!State.IsOpen)
        {
            _lastScrolledIndex = -1;  // reset when closed so next open re-scrolls
        }

        _wasOpen = State.IsOpen;
    }

    public void Dispose()
    {
        State.Changed -= OnChanged;
        _inputTimer?.Dispose();
    }
}
