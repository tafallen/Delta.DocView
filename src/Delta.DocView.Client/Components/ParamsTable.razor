@using Delta.DocView.Shared.Models

@if (Step.Params.Count > 0)
{
    <div class="params-section">
        <h3 class="detail-section-title">Parameters</h3>
        <table class="params-table" data-testid="params-table">
            <thead>
                <tr><th>Name</th><th>Type</th><th>Example / Columns</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Step.Params)
                {
                    <tr>
                        <td class="param-cell-name"><code>@p.Name</code></td>
                        <td class="param-cell-type">
                            <span class="param-type-chip param-@UiStrings.DisplayParamType(p.Type).ToLowerInvariant()">@UiStrings.DisplayParamType(p.Type)</span>
                            @if (p.HasTable)
                            {
                                <span class="param-table-badge" title="@(p.ColumnsSource is not null ? $"Columns from: {p.ColumnsSource}" : "DataTable")">table</span>
                            }
                        </td>
                        <td class="param-cell-example">
                            @if (p.HasTable && p.Columns.Count > 0)
                            {
                                <table class="param-columns-table" data-testid="param-table-cols">
                                    <thead>
                                        <tr><th>Column</th><th>Type</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var col in p.Columns)
                                        {
                                            <tr>
                                                <td><code>@col.Name</code></td>
                                                <td><span class="param-type-chip param-@col.Type.ToLowerInvariant()">@col.Type</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else if (!p.HasTable)
                            {
                                <code>"@p.Example"</code>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Step Step { get; set; } = default!;
}
