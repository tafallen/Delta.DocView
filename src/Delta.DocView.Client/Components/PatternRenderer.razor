@using Delta.DocView.Client.Services
@foreach (var token in PatternTokeniser.Tokenise(Pattern))
{
    if (token is ParamToken pt)
    {
        var typeLower = pt.Type.ToLowerInvariant();
        <span class="param-pill param-@typeLower">
            @if (!string.IsNullOrEmpty(pt.Name))
            {
                <em class="param-name">@pt.Name</em>@(":")<span class="param-type">@pt.Type</span>
            }
            else
            {
                <span class="param-type">@pt.Type</span>
            }
        </span>
    }
    else if (token is StaticText st)
    {
        <HighlightRenderer Text="@st.Text" Query="@Query" />
    }
}

@code {
    [Parameter, EditorRequired] public string Pattern { get; set; } = "";
    [Parameter] public string? Query { get; set; }
}
