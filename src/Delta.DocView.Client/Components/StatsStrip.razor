@using Delta.DocView.Shared.Models

<div class="stats-strip">
    <div class="stat-col">
        <span class="stat-label">Used in</span>
        <span class="stat-value" data-testid="stat-used">@Step.Used scenarios</span>
    </div>
    <div class="stat-col">
        <span class="stat-label">Source</span>
        <code class="stat-value" data-testid="stat-source">@Step.File:@Step.Line</code>
    </div>
    @if (Step.Tags.Count > 0)
    {
        <div class="stat-col">
            <span class="stat-label">Tags</span>
            <span class="stat-value" data-testid="stat-tags">@(string.Join(" · ", Step.Tags))</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Step Step { get; set; } = default!;
}
