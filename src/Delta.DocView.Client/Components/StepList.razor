@implements IDisposable
@inject ClientStepLibraryStore Store
@inject FilterState State
@inject FilteredStepsProvider Provider

<div class="step-list">
    <div class="step-list-header">
        <span class="step-list-count" data-testid="step-list-count">
            @Provider.Filtered.Count of @Store.Steps.Count matching@(string.IsNullOrWhiteSpace(State.Query) ? "" : $" for \"{State.Query.Trim()}\"")
        </span>
        <button class="sort-button" disabled title="Sorted by most used (no alternative sort in v1)">↓ Sorted by most used</button>
    </div>
    @if (Store.Steps.Count == 0)
    {
        <div class="step-list-empty" data-testid="step-list-empty-library">
            <p>No steps in library.</p>
            <p class="hint">Check that <code>DOCVIEW_LIBRARY_PATH</code> points to a populated <code>step-library.v1.json</code>.</p>
        </div>
    }
    else if (Provider.Filtered.Count == 0)
    {
        <div class="step-list-empty" data-testid="step-list-empty">
            <p>No steps match your filters.</p>
            <p class="hint">Try clearing a filter or shortening your search.</p>
        </div>
    }
    else
    {
        <GroupedList Steps="Provider.Filtered" Query="@State.Query" Grouped="@(State.Domain is null)" Domains="Store.Domains" />
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Provider.Changed += OnChanged;
    }

    private void OnChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Provider.Changed -= OnChanged;
    }
}
