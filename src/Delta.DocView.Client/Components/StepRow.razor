@using Delta.DocView.Client.Services
@using Delta.DocView.Shared.Models
@implements IDisposable
@inject IFavouritesStore Favs
@inject SelectionState Selection
@inject ComposerState Composer

<div class="step-row @(IsSelected ? "is-selected" : "")" data-step-id="@Step.Id" @onclick="OnRowClick">
    <span class="type-chip chip-@Step.Type.ToLowerInvariant()">@Step.Type</span>
    <div class="step-body">
        <div class="step-pattern"><PatternRenderer Pattern="@Step.Pattern" Query="@Query" /></div>
        <div class="step-meta">
            <span class="step-file"><span class="file-icon">&#x25A1;</span> @Step.File :@Step.Line</span>
            <div class="step-tags-row">
                @foreach (var tag in Step.Tags.Take(3))
                {
                    <span class="tag-pill">@tag</span>
                }
                @if (Step.Tags.Count > 3)
                {
                    <span class="tag-pill">+@(Step.Tags.Count - 3)</span>
                }
                <span class="step-used">@Step.Used uses</span>
            </div>
        </div>
    </div>
    <div class="step-actions">
        <button class="row-star @(Favs.Has(Step.Id) ? "is-fav" : "")" data-testid="row-star" @onclick="OnStarClick" @onclick:stopPropagation="true">★</button>
        <button class="row-add" data-testid="row-add" @onclick="OnAddClick" @onclick:stopPropagation="true">＋</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Step Step { get; set; } = default!;
    [Parameter] public string? Query { get; set; }
    [Parameter] public bool IsSelected { get; set; }

    protected override void OnInitialized()
    {
        Favs.Changed += OnChanged;
    }

    private void OnRowClick() => Selection.Select(Step);

    private void OnStarClick() => Favs.Toggle(Step.Id);

    private void OnAddClick() => Composer.AddStep(Step);

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Favs.Changed -= OnChanged;
    }
}
