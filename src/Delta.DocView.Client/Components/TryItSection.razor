@using Delta.DocView.Client.Services
@using Delta.DocView.Shared.Models

<div class="try-it" data-testid="try-it">
    <div class="try-it-heading">
        <span class="detail-section-title">Try it</span>
        <span class="try-it-hint">edit the values to see the resulting Gherkin line</span>
    </div>
    @if (_isTableStep)
    {
        <div class="try-it-datatable-note" data-testid="try-it-datatable" role="note">
            📋 This step accepts a <strong>DataTable</strong>. The step keyword is ready to copy below — add the data table rows directly in your <code>.feature</code> file.
        </div>
    }
    else if (_hasMismatch)
    {
        <div class="try-it-mismatch" data-testid="try-it-mismatch" role="alert">
            ⚠ This step has @_expectedParamCount parameter @(_expectedParamCount == 1 ? "token" : "tokens") in its pattern but @_actualParamCount @(_actualParamCount == 1 ? "param" : "params") defined. The composed line below may be incomplete.
        </div>
    }
    <div class="try-it-body">
        @if (_paramIndices.Count > 0)
        {
            <div class="try-it-inputs">
                @for (var i = 0; i < _paramIndices.Count; i++)
                {
                    var idx = i;
                    var param = (idx < Step.Params.Count) ? Step.Params[idx] : null;
                    var inputId = $"try-it-{_uid}-{idx}";
                    <div class="try-it-row">
                        <div class="try-it-row-header">
                            <label for="@inputId" class="try-it-param-name">@(param?.Name is { Length: > 0 } n ? n : (param?.Type ?? "value"))</label>
                            @if (param is not null)
                            {
                                <span class="param-type-chip param-@UiStrings.DisplayParamType(param.Type).ToLowerInvariant()">@UiStrings.DisplayParamType(param.Type)</span>
                            }
                        </div>
                        <input id="@inputId" type="text" class="try-it-field" value="@_inputs[idx]" @oninput="e => OnInput(idx, e)" />
                    </div>
                }
            </div>
        }
        <div class="try-it-output">
            <div class="try-it-output-header">
                <span class="try-it-output-label">Composed line</span>
                <CopyButton Text="@_composed" Label="Copy" ConfirmLabel="✓ copied" />
            </div>
            <pre class="composed-line" data-testid="composed-line" aria-label="Composed line preview" aria-live="polite">@_composed</pre>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Step Step { get; set; } = default!;

    private IReadOnlyList<PatternToken> _tokens = Array.Empty<PatternToken>();
    private List<int> _paramIndices = new();
    private string[] _inputs = Array.Empty<string>();
    private string _composed = "";
    private string _uid = "";
    private bool _hasMismatch;
    private bool _isTableStep;
    private int _expectedParamCount;
    private int _actualParamCount;

    protected override void OnInitialized()
    {
        _uid = Guid.NewGuid().ToString("N")[..8];
    }

    protected override void OnParametersSet()
    {
        _tokens = PatternTokeniser.Tokenise(Step.Pattern);
        _paramIndices = _tokens
            .Select((t, idx) => (t, idx))
            .Where(p => p.t is ParamToken)
            .Select(p => p.idx)
            .ToList();
        _expectedParamCount = _paramIndices.Count;
        _actualParamCount = Step.Params.Count;
        // A step is a "table step" when all its params are DataTable params and there are
        // no inline {token} slots — the mismatch is expected and informative, not an error.
        _isTableStep = Step.Params.Count > 0 && Step.Params.All(p => p.HasTable) && _paramIndices.Count == 0;
        _hasMismatch = !_isTableStep && _expectedParamCount != _actualParamCount;
        _inputs = new string[_paramIndices.Count];
        for (var i = 0; i < _paramIndices.Count; i++)
        {
            _inputs[i] = (i < Step.Params.Count) ? (Step.Params[i].Example ?? "") : "";
        }
        Recompose();
    }

    private void OnInput(int positionalIndex, Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _inputs[positionalIndex] = e.Value?.ToString() ?? "";
        Recompose();
    }

    private void Recompose()
    {
        var sb = new System.Text.StringBuilder();
        var paramOrd = 0;
        foreach (var t in _tokens)
        {
            switch (t)
            {
                case StaticText s:
                    sb.Append(s.Text);
                    break;
                case ParamToken:
                    sb.Append(paramOrd < _inputs.Length ? _inputs[paramOrd] : "");
                    paramOrd++;
                    break;
            }
        }
        // Append DataTable column header + empty row for table params
        foreach (var p in Step.Params.Where(param => param.HasTable && param.Columns.Count > 0))
        {
            sb.Append(FeatureTextBuilder.AppendTableRows(p.Columns.Select(c => c.Name)));
        }
        _composed = sb.ToString();
    }
}
