@inject ClientStepLibraryStore Store
@inject IJSRuntime JS
@inject FilterState Filter
@inject IPlatform Platform
@inject IKeyboardActions Actions
@inject TweaksPanelState Panel
@implements IDisposable

<header class="app-header">
    <div class="header-brand">
        <svg width="28" height="28" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <rect x="1.5" y="1.5" width="19" height="19" rx="4.5" fill="#e06c2b"/>
            <path d="M6 8h7M6 11h10M6 14h5" stroke="white" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <div class="header-titles">
            <span class="header-title">Triangle · Step Library</span>
            <span class="header-subtitle">@Store.Steps.Count steps · v@(Store.Version)</span>
        </div>
    </div>

    <div class="header-search">
        <input type="search" class="search-input"
               placeholder="Search steps…"
               aria-label="Search steps"
               value="@Filter.Query"
               @oninput="OnSearchInput" />
        <button class="btn-quickfind"
                data-testid="quick-find"
                type="button"
                title="@($"Quick find ({Platform.ShortcutLabel("K")})")"
                aria-label="@($"Quick find ({Platform.ShortcutLabel("K")})")"
                @onclick="Actions.OpenPalette">
            @Platform.ShortcutLabel("K")
        </button>
    </div>

    <div class="header-actions">
        <button class="btn-icon" type="button"
                data-testid="shortcuts-button"
                title="Keyboard shortcuts" aria-label="Keyboard shortcuts"
                @onclick="Actions.OpenShortcuts">?</button>
        <button class="btn-icon" type="button"
                data-testid="tweaks-button"
                title="Appearance settings" aria-label="Appearance settings"
                @onclick="Panel.Toggle">⚙</button>
        <button class="btn-icon" type="button"
                data-testid="dark-toggle"
                title="Toggle dark mode" aria-label="Toggle dark mode"
                @onclick="ToggleDarkAsync">
            @(_isDark ? "☀" : "🌙")
        </button>
        <div class="avatar-chip" aria-label="User avatar">QA</div>
    </div>
</header>

@code {
    private const int SearchDebounceMs = 150;

    private bool _isDark;
    private System.Threading.Timer? _searchDebounce;
    private string? _pendingValue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _isDark = await JS.InvokeAsync<bool>("docview.prefersDark");
        await JS.InvokeVoidAsync("docview.setDark", _isDark);
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        Filter.Changed += OnFilterChanged;
        _searchDebounce = new System.Threading.Timer(_ => DispatchPendingQuery(), null, System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _pendingValue = e.Value?.ToString();
        _searchDebounce?.Change(SearchDebounceMs, System.Threading.Timeout.Infinite);
    }

    private void DispatchPendingQuery()
    {
        InvokeAsync(() => Filter.SetQuery(_pendingValue));
    }

    private void OnFilterChanged() => InvokeAsync(StateHasChanged);

    private async Task ToggleDarkAsync()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("docview.setDark", _isDark);
    }

    public void Dispose()
    {
        Filter.Changed -= OnFilterChanged;
        _searchDebounce?.Dispose();
    }
}
