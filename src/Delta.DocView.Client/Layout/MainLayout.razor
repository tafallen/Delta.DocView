@using Delta.DocView.Client.Components

<div class="app-shell">
    <KeyboardHandler />
    <Palette />
    <ShortcutsOverlay />
    <Header />

    @if (Warning is not null)
    {
        <div class="warning-banner" role="alert">
            ⚠ @Warning
        </div>
    }

    <div class="app-body">
        <aside class="left-rail">
            <LeftRail />
        </aside>
        <section class="step-list-panel">
            <StepList />
        </section>
        <section class="detail-panel">
            <DetailPanel />
        </section>
    </div>
    <ScenarioComposer />
</div>

@code {
    [Parameter] public string? Warning { get; set; }
}
